# Local defaults for `docker compose up`. Replace every local-* value before
# exposing this instance publicly. Variables not listed here keep code defaults.

# --- Core ---
POSTGRES_PASSWORD=codasaurus
# First-owner credential on an empty database: openssl rand -hex 32
CODASAURUS_BOOTSTRAP_SECRET=local-dev-bootstrap-change-me
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
PUBLIC_URL=http://localhost:3000
# Set PUBLIC_URL to the externally reachable URL when APP_PORT changes.
# DATABASE_URL and REDIS_URL are injected by Compose; set them for `cargo run`:
# DATABASE_URL=postgres://codasaurus:codasaurus@127.0.0.1:5432/codasaurus
# REDIS_URL=redis://127.0.0.1:6379
# CODASAURUS_DATA_DIR=/data
# CODASAURUS_CONFIG=/path/to/.codasaurus.toml

# --- GitHub App (or use the setup wizard) ---
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_WEBHOOK_SECRET=
# Raw PEM or base64 of it; either works:
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_B64=

# --- LiteLLM gateway ---
# Compose starts the sidecar; these keys are for management, never inference.
LITELLM_MASTER_KEY=sk-codasaurus-local
# Salt change invalidates stored provider keys; keep it stable.
LITELLM_SALT_KEY=local-dev-salt-change-me
LITELLM_DATABASE_URL=postgresql://codasaurus:codasaurus@postgres:5432/litellm
# CODASAURUS_BASE_URL=http://litellm:4000/v1
# Legacy direct endpoint credential; dashboard-managed keys live in the database.
# CODASAURUS_API_KEY=

# --- Models and budget (managed in Settings → LLM) ---
# CODASAURUS_MODEL=
# CODASAURUS_MODEL_CHEAP=
# CODASAURUS_EMBEDDING_MODEL=
# CODASAURUS_LLM_DAILY_BUDGET_USD=
# CODASAURUS_OFFLINE=0

# --- Queue and workers ---
# CODASAURUS_QUEUE_WORKERS=2
# CODASAURUS_CLAIM_BATCH=1
# CODASAURUS_QUEUE_DEFAULT_PRIORITY=100
# CODASAURUS_MAX_CONCURRENT_REVIEWS=4
# CODASAURUS_REVIEW_TIMEOUT_SECS=300
# CODASAURUS_FREE_TIER=0
# CODASAURUS_INSTANCE_ID=

# --- Database pool ---
# CODASAURUS_DB_MAX_CONNECTIONS=16
# CODASAURUS_DB_ACQUIRE_TIMEOUT_SECS=30
# CODASAURUS_DB_IDLE_TIMEOUT_SECS=600
# CODASAURUS_DB_MAX_LIFETIME_SECS=1800
# CODASAURUS_AUDIT_RETENTION_DAYS=90

# --- Limits, timeouts and caches ---
# CODASAURUS_HTTP_TIMEOUT_SECS=120
# CODASAURUS_MAX_BODY_BYTES=26214400
# CODASAURUS_BOOTSTRAP_TTL_SECS=900
# CODASAURUS_SESSION_MAX_AGE_SECS=604800
# CODASAURUS_LOGIN_RATE_LIMIT=10
# CODASAURUS_LOGIN_RATE_WINDOW_SECS=900
# CODASAURUS_API_RATE_LIMIT_PER_MIN=100
# CODASAURUS_WEBHOOK_RATE_LIMIT_PER_MIN=300
# CODASAURUS_LLM_TIMEOUT_SECS=60
# CODASAURUS_LLM_CONNECT_TIMEOUT_SECS=10
# CODASAURUS_RETRY_MAX_ATTEMPTS=3
# CODASAURUS_RETRY_BASE_DELAY_MS=1000
# CODASAURUS_RETRY_MAX_DELAY_MS=30000
# CODASAURUS_STATS_CACHE_TTL_SECS=30
# CODASAURUS_CONFIG_CACHE_TTL_SECS=60
# CODASAURUS_GH_CACHE_MAX_ENTRIES=2000
# CODASAURUS_GH_CACHE_TTL_SECS=3600
# CODASAURUS_MCP_CACHE_TTL_SECS=300
# CODASAURUS_MCP_MAX_CACHED_SERVERS=256

# --- Review output ---
# CODASAURUS_MAX_INLINE_COMMENTS=8
# CODASAURUS_MAX_REVIEWER_FILES=8
# CODASAURUS_MAX_COMMENT_BYTES=64000
# CODASAURUS_MAX_LLM_DIFF_CHARS=24000
# CODASAURUS_AUTO_IMPROVE_MAX_FILES=40
# CODASAURUS_AUTO_IMPROVE_MAX_DIFF=24000

# --- Security and network ---
# CODASAURUS_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# CODASAURUS_HSTS=0
# Secure and insecure cookies are mutually exclusive; secure wins when both set.
# CODASAURUS_SECURE_COOKIES=1
# CODASAURUS_INSECURE_COOKIES=0
# CODASAURUS_METRICS_TOKEN=

# --- SSO / OIDC ---
# Compose can run the bundled ZITADEL identity provider with:
#   docker compose --profile identity up -d
# Set CODASAURUS_AUTH_MODE=zitadel to disable local password/invite flows.
# For production, use the externally reachable ZITADEL issuer URL.
# CODASAURUS_AUTH_MODE=zitadel
# ZITADEL_VERSION=v4.20.2
# ZITADEL_MASTERKEY=codasaurus-zitadel-masterkey-32!
# ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=ChangeMe1!
# ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=zitadel-admin@zitadel.localhost
# ZITADEL_FIRSTINSTANCE_ORG_NAME=Codasaurus
# ZITADEL_DOMAIN=localhost
# ZITADEL_PORT=8080
# ZITADEL_EXTERNALPORT=8080
# ZITADEL_EXTERNALSECURE=false
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://reviews.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_ALLOW_OPEN_JOIN=0
# OIDC_ALLOW_UNVERIFIED_EMAIL=0
# OIDC_ALLOW_PUBLIC_CLIENT=0
# ZITADEL_ISSUER=http://localhost:8080
# ZITADEL_CLIENT_ID=
# ZITADEL_CLIENT_SECRET=

# --- Ticket context ---
# JIRA_BASE_URL=https://org.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# LINEAR_API_KEY=
