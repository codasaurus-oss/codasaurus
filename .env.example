# Copy to .env before `docker compose up`. These are local-only defaults;
# replace the LiteLLM key and salt before exposing this instance publicly.

# --- Postgres (compose service uses these) ---
# Compose pins pgvector 0.8.7 on PostgreSQL 19. An existing 16.x data volume
# cannot start under 19: dump/restore into a fresh volume before upgrading.
POSTGRES_PASSWORD=codasaurus

# --- App ---
# Needed to create the first owner on an empty database. Replace for anything
# public; generate one with `openssl rand -hex 32`.
CODASAURUS_BOOTSTRAP_SECRET=local-dev-bootstrap-change-me
# DATABASE_URL is set automatically in docker-compose.yml.
# For cargo run against local Postgres:
# DATABASE_URL=postgres://codasaurus:codasaurus@127.0.0.1:5432/codasaurus

PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000

# --- GitHub App (or configure in the dashboard wizard) ---
# GITHUB_APP_ID=
# Raw PEM (multiline) or base64 of the PEM — either works at runtime:
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_B64=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# --- LLM (LiteLLM gateway sidecar; also editable in Settings → LLM) ---
# Optional legacy/direct-endpoint inference credential. Dashboard-managed setup
# stores a model-scoped virtual key in the Codasaurus database; Compose does not
# set this to the LiteLLM master key.
# CODASAURUS_API_KEY=
# Required for non-compose deployments: the gateway's OpenAI-compatible base URL.
# Compose injects http://litellm:4000/v1.
# CODASAURUS_BASE_URL=
# Sidecar admin key (must start with sk-). Codasaurus uses it only to register
# models and keys through LiteLLM's management API, never for inference.
LITELLM_MASTER_KEY=sk-codasaurus-local
# Gateway model storage uses a dedicated database on the same Postgres server,
# so there is still one datastore to back up. LiteLLM's migrations need a clean
# schema and cannot share the app database. Keep the salt key stable: rotating
# it makes already stored provider keys unreadable.
LITELLM_DATABASE_URL=postgresql://codasaurus:codasaurus@postgres:5432/litellm
LITELLM_SALT_KEY=local-dev-salt-change-me
# Alias names managed from Settings → LLM. No defaults: an unset CODASAURUS_MODEL
# disables the LLM, an unset embedding alias skips the semantic index.
# CODASAURUS_MODEL=
# CODASAURUS_MODEL_CHEAP=
# CODASAURUS_EMBEDDING_MODEL=
# CODASAURUS_OFFLINE=0
# Gateway-enforced daily budget on the managed virtual key. Empty/0 = unlimited.
# CODASAURUS_LLM_DAILY_BUDGET_USD=

# --- Ops knobs (also editable in Settings → System) ---
# CODASAURUS_QUEUE_WORKERS=2
# Jobs claimed per database round-trip (1-50) and default priority (smaller first).
# CODASAURUS_CLAIM_BATCH=1
# CODASAURUS_QUEUE_DEFAULT_PRIORITY=100
# CODASAURUS_MAX_CONCURRENT_REVIEWS=4
# CODASAURUS_CONFIG_CACHE_TTL_SECS=60
# CODASAURUS_AUDIT_RETENTION_DAYS=90
# CODASAURUS_REVIEW_TIMEOUT_SECS=300
# CODASAURUS_MAX_INLINE_COMMENTS=8
# CODASAURUS_MAX_REVIEWER_FILES=8
# CODASAURUS_MAX_COMMENT_BYTES=64000
# CODASAURUS_MAX_LLM_DIFF_CHARS=8000
# CODASAURUS_AUTO_IMPROVE_MAX_FILES=40
# CODASAURUS_AUTO_IMPROVE_MAX_DIFF=24000
# CODASAURUS_METRICS_TOKEN=
# CODASAURUS_HSTS=0
# CODASAURUS_INSECURE_COOKIES=0
# CODASAURUS_SECURE_COOKIES=1

# --- SSO / OIDC (also editable in Settings → Connections) ---
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://reviews.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# Accepts 1/true/yes/on (dashboard toggles send "true"):
# OIDC_ALLOW_OPEN_JOIN=0
# OIDC_ALLOW_UNVERIFIED_EMAIL=0
# OIDC_ALLOW_PUBLIC_CLIENT=0

# --- Ticket context on PRs (Settings → Connections → Tickets) ---
# JIRA_BASE_URL=https://org.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# LINEAR_API_KEY=
